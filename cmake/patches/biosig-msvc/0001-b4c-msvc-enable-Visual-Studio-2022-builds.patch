 int ifsetpos(HDRTYPE* hdr, size_t *pos) {
+#ifdef _WIN32
+#ifdef ZLIB_H
+	if (hdr->FILE.COMPRESSION) {
+		gzseek(hdr->FILE.gzFID,*pos,SEEK_SET);
+		size_t pos1 = *pos;
+		*pos = gztell(hdr->FILE.gzFID);
+		return(*pos - pos1);
+	}
+	else
+#endif
+	{
+		int c = _fseeki64(hdr->FILE.FID, (__int64)(*pos), SEEK_SET);
+		if (c == 0) {
+			*pos = (size_t)_ftelli64(hdr->FILE.FID);
+		}
