 biosig4c++/t210/sopen_scp_read.c   |  5 ++-
 biosig4c++/t220/sopen_scp_write.c  |  3 ++
 biosig4c++/t230/sopen_hl7aecg.cpp  |  9 ++++-
 biosig4c++/win32/getdelim.c        |  5 +++
 biosig4c++/win32/getlogin.c        |  4 +-
 17 files changed, 236 insertions(+), 30 deletions(-)
 create mode 100644 biosig4c++/t210/sopen_msvc_stubs.c

diff --git a/biosig4c++/CMakeLists.txt b/biosig4c++/CMakeLists.txt
index 57dc45a4..2a0e73ab 100644
--- a/biosig4c++/CMakeLists.txt
+++ b/biosig4c++/CMakeLists.txt
@@ -4,12 +4,26 @@ project (libbiosig)
 option (USE_ZLIB "Add support for compressed files." OFF)
 option (USE_SUITESPARSE "Add support for automatic re-referencing." OFF)

-# Version number
-set (libbiosig_VERSION_MAJOR 1)
-set (libbiosig_VERSION_MINOR 8)
-set (libbiosig_VERSION_PATCH 4)
+# The release version is independent of the libbiosig API/ABI version.
+file (STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/../configure.ac" _biosig_release REGEX "^AC_INIT")
+string (REGEX MATCH "\\[([0-9]+)\\.([0-9]+)\\.([0-9]+)\\]" _biosig_release_match "${_biosig_release}")
+set (libbiosig_VERSION_MAJOR ${CMAKE_MATCH_1})
+set (libbiosig_VERSION_MINOR ${CMAKE_MATCH_2})
+set (libbiosig_VERSION_PATCH ${CMAKE_MATCH_3})
+
+find_program (GAWK
+  NAMES gawk awk
+  PATHS "C:/Program Files/Git/usr/bin" "C:/msys64/usr/bin" "C:/msys32/usr/bin"
+  REQUIRED
+)

-find_program (GAWK NAMES gawk REQUIRED)
+# Git checkouts on Windows may represent this symlink as a text file.
+set (_extern_dir "${CMAKE_CURRENT_SOURCE_DIR}/extern")
+if (NOT IS_DIRECTORY "${_extern_dir}")
+  file (READ "${_extern_dir}" _extern_relpath)
+  string (STRIP "${_extern_relpath}" _extern_relpath)
+  set (_extern_dir "${CMAKE_CURRENT_SOURCE_DIR}/${_extern_relpath}")
+endif ()

 set (generated_tables
   "${CMAKE_CURRENT_BINARY_DIR}/eventcodes.i"
@@ -22,9 +36,9 @@ add_custom_command (
   OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/eventcodes.i"
          "${CMAKE_CURRENT_BINARY_DIR}/eventcodegroups.i"
   COMMAND "${GAWK}" -f "${CMAKE_CURRENT_SOURCE_DIR}/eventcodes.awk"
-          "${CMAKE_CURRENT_SOURCE_DIR}/extern/eventcodes.txt"
+          "${_extern_dir}/eventcodes.txt"
   WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
-  DEPENDS eventcodes.awk extern/eventcodes.txt
+  DEPENDS eventcodes.awk "${_extern_dir}/eventcodes.txt"
   VERBATIM
 )

@@ -34,10 +48,10 @@ function (biosig_generate_table output script input)
     COMMAND "${CMAKE_COMMAND}"
       "-DGAWK=${GAWK}"
       "-DAWK_SCRIPT=${CMAKE_CURRENT_SOURCE_DIR}/${script}"
-      "-DAWK_INPUT=${CMAKE_CURRENT_SOURCE_DIR}/extern/${input}"
+      "-DAWK_INPUT=${_extern_dir}/${input}"
       "-DAWK_OUTPUT=${CMAKE_CURRENT_BINARY_DIR}/${output}"
       -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/RunAwk.cmake"
-    DEPENDS ${script} extern/${input} cmake/RunAwk.cmake
+    DEPENDS ${script} "${_extern_dir}/${input}" cmake/RunAwk.cmake
     VERBATIM
   )
 endfunction ()
@@ -97,6 +111,26 @@ if (WIN32)
   )
 endif ()

+if (MSVC)
+  # Keep the existing MSVC reader coverage; these readers still need porting.
+  list (REMOVE_ITEM sources
+    t210/sopen_acqbiopac.c t210/sopen_biosigdump_read.c
+    t210/sopen_fiff.c t210/sopen_hdf5.c t210/sopen_matio.c
+    t210/sopen_nicolet.c t210/sopen_rhd2000_read.c t210/sopen_sqlite.c
+  )
+  list (APPEND sources t210/sopen_msvc_stubs.c)
+endif ()
+
+if (CMAKE_C_COMPILER_ID STREQUAL "MSVC")
+  if (CMAKE_C_COMPILER_VERSION VERSION_LESS "19.39.33428")
+    message (FATAL_ERROR "BioSig requires Visual Studio 2022 17.9 (MSVC 19.39.33428) or newer")
+  endif ()
+  # Visual Studio needs per-source options for mixed C/C++ targets.
+  set (_biosig_c_sources ${sources} biosig2.c)
+  list (FILTER _biosig_c_sources INCLUDE REGEX "[.]c$")
+  set_property (SOURCE ${_biosig_c_sources} APPEND PROPERTY COMPILE_OPTIONS /std:clatest)
+endif ()
+
 if (APPLE)
   list (APPEND sources
     win32/getdelim.c
@@ -145,6 +179,10 @@ if (APPLE)
      )
 endif ()

+if (WIN32)
+  set_target_properties (biosigshared biosig2shared PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
+endif ()
+
 find_package (Iconv REQUIRED)

 if (USE_ZLIB)
@@ -164,6 +202,9 @@ foreach (target biosigstatic biosigshared biosig2static biosig2shared)
   )
   target_compile_definitions (${target} PRIVATE WITHOUT_NETWORK)
   target_link_libraries (${target} PRIVATE Iconv::Iconv)
+  if (WIN32)
+    target_link_libraries (${target} PRIVATE ws2_32)
+  endif ()

   if (USE_ZLIB)
     target_compile_definitions (${target} PUBLIC HAVE_ZLIB)
