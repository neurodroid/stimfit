+    message (FATAL_ERROR "BioSig requires Visual Studio 2022 17.9 (MSVC 19.39.33428) or newer")
+  endif ()
+  # Keep upstream typeof declarations and casts using C23 support.
+  # Visual Studio needs per-source options for mixed C/C++ targets.
+  set (_biosig_c_sources ${sources} biosig2.c)
+  list (FILTER _biosig_c_sources INCLUDE REGEX "[.]c$")
+  set_property (SOURCE ${_biosig_c_sources} APPEND PROPERTY COMPILE_OPTIONS /std:clatest)
+endif ()
